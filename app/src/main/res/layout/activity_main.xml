<?xml version="1.0" encoding="utf-8"?>
<!--
    Click — iPhone-inspired camera screen.
    Layering (bottom → top):
      1. PreviewView      : live viewfinder
      2. FocusOverlay     : tap-to-focus square + exposure slider (+ pinch zoom)
      3. shutter_flash    : instant black-out shutter flash
      4. top_bar          : pitch-black quick-control pill bar
      5. bottom_bar       : pitch-black gesture/mode scroller + shutter row
      6. pro_drawer       : manual ISO drawer (slides from bottom)
      7. flash_screen     : bright white screen flash (front-camera selfie flash)
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/click_black">

    <!-- Live viewfinder -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/click_black"
        app:implementationMode="compatible"
        app:scaleType="fillCenter" />

    <!-- Tap-to-focus overlay (also hosts pinch-to-zoom) -->
    <zx.offical.click.ui.FocusOverlay
        android:id="@+id/focus_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Instant black-out shutter flash -->
    <View
        android:id="@+id/shutter_flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0f"
        android:background="@color/click_black"
        android:visibility="invisible" />

    <!-- Top quick-control pill bar (pure pitch-black) -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:background="@color/click_black"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <!-- Flash pill -->
        <LinearLayout
            android:id="@+id/flash_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">

            <ImageView
                android:id="@+id/flash_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/cd_flash"
                android:src="@drawable/ic_flash_off" />

            <TextView
                android:id="@+id/flash_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="OFF"
                android:textColor="@color/click_dim"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Space
            android:layout_width="9dp"
            android:layout_height="1dp" />

        <!-- Aspect ratio pill -->
        <LinearLayout
            android:id="@+id/aspect_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">

            <ImageView
                android:id="@+id/aspect_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/cd_aspect"
                android:src="@drawable/ic_aspect" />

            <TextView
                android:id="@+id/aspect_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="4:3"
                android:textColor="@color/click_dim"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Space
            android:layout_width="9dp"
            android:layout_height="1dp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Dynamic resolution / FPS badge (video mode) -->
        <TextView
            android:id="@+id/res_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:paddingHorizontal="11dp"
            android:paddingVertical="7dp"
            android:textColor="@color/click_white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Space
            android:layout_width="9dp"
            android:layout_height="1dp" />

        <!-- Recording indicator (red dot + timer) -->
        <LinearLayout
            android:id="@+id/rec_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <View
                android:id="@+id/rec_dot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:background="@drawable/bg_rec_dot" />

            <TextView
                android:id="@+id/rec_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-monospace"
                android:text="00:00"
                android:textColor="@color/click_white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Space
            android:layout_width="9dp"
            android:layout_height="1dp" />

        <!-- Pro / ISO drawer pill -->
        <LinearLayout
            android:id="@+id/pro_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="11dp"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/pro_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/cd_pro"
                android:src="@drawable/ic_sliders" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom gesture & mode scroller zone (pure pitch-black) -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/click_black"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="26dp">

        <!-- Live zoom pill row -->
        <LinearLayout
            android:id="@+id/zoom_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/zoom_1x"
                android:layout_width="54dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_zoom_pill"
                android:contentDescription="@string/cd_zoom"
                android:gravity="center"
                android:text="1x"
                android:textColor="@color/click_dim"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/zoom_2x"
                android:layout_width="54dp"
                android:layout_height="36dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_zoom_pill"
                android:contentDescription="@string/cd_zoom"
                android:gravity="center"
                android:text="2x"
                android:textColor="@color/click_dim"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/zoom_4x"
                android:layout_width="54dp"
                android:layout_height="36dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_zoom_pill"
                android:contentDescription="@string/cd_zoom"
                android:gravity="center"
                android:text="4x"
                android:textColor="@color/click_dim"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="16dp" />

        <!-- PHOTO / VIDEO horizontal swipe + tap mode selector -->
        <zx.offical.click.ui.ModeScroller
            android:id="@+id/mode_scroller"
            android:layout_width="200dp"
            android:layout_height="44dp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="22dp" />

        <!-- Thumbnail | Shutter | Flip -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/thumb_view"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_thumb"
                android:contentDescription="@string/cd_last_media"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_thumb" />

            <View
                android:layout_width="30dp"
                android:layout_height="1dp" />

            <zx.offical.click.ui.ShutterButton
                android:id="@+id/shutter_btn"
                android:layout_width="84dp"
                android:layout_height="84dp" />

            <View
                android:layout_width="30dp"
                android:layout_height="1dp" />

            <ImageView
                android:id="@+id/flip_btn"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/flip_bg"
                android:contentDescription="@string/cd_flip_camera"
                android:padding="12dp"
                android:src="@drawable/ic_camera_flip" />
        </LinearLayout>
    </LinearLayout>

    <!-- Manual ISO drawer -->
    <LinearLayout
        android:id="@+id/pro_drawer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/pro_drawer_height"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_drawer"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="10dp"
        android:translationY="@dimen/pro_drawer_height">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/drawer_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MANUAL ISO"
                android:textColor="@color/click_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/auto_iso_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_zoom_pill"
                android:paddingHorizontal="16dp"
                android:paddingVertical="7dp"
                android:text="AUTO"
                android:textColor="@color/click_yellow"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/iso_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="ISO 100"
            android:textColor="@color/click_yellow"
            android:textSize="20sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/iso_seekbar"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:max="3100"
            android:progress="0"
            android:progressTint="@color/click_yellow"
            android:thumbTint="@color/click_white" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Drag to lock ISO. Tap AUTO to return to automatic exposure."
            android:textColor="@color/click_dim"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Bright white screen flash for front-camera selfies -->
    <View
        android:id="@+id/flash_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0f"
        android:background="@color/click_white"
        android:visibility="invisible" />

</FrameLayout>
