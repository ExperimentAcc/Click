<?xml version="1.0" encoding="utf-8"?>
<!-- ShutterButton: white ring + morphing inner icon. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/shutter_ring"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shutter_ring" />

    <ImageView
        android:id="@+id/shutter_icon_a"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:contentDescription="@string/cd_shutter"
        android:gravity="center"
        android:src="@drawable/ic_shutter_photo" />

    <ImageView
        android:id="@+id/shutter_icon_b"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:contentDescription="@string/cd_shutter"
        android:gravity="center"
        android:src="@drawable/ic_shutter_photo"
        android:alpha="0.0" />
</FrameLayout>
